# ⚙️ Environment Configuration - World Events
# Copy this to .env and fill in your values
# This file is for configuration in production

# ═════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# ═════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═════════════════════════════════════════════════════════════
# Currently using JSON file, can be changed to MongoDB
DB_TYPE=json
# DB_TYPE=mongodb
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/world-events

# ═════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (SMTP)
# ═════════════════════════════════════════════════════════════
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_NAME="World Events"
SMTP_FROM_EMAIL=noreply@world-events.com

# ═════════════════════════════════════════════════════════════
# TWILIO SMS CONFIGURATION (Optional)
# ═════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═════════════════════════════════════════════════════════════
# JWT AUTHENTICATION (To implement)
# ═════════════════════════════════════════════════════════════
JWT_SECRET=your-super-secret-key-here-min-32-chars-long
JWT_EXPIRATION=7d

# ═════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=http://localhost:3000,https://world-events.com,https://app.world-events.com

# ═════════════════════════════════════════════════════════════
# API ENDPOINTS (For Frontend)
# ═════════════════════════════════════════════════════════════
REACT_APP_API_URL=http://localhost:3000
REACT_APP_CLOUD_API_URL=https://world-events-backend-ji93.onrender.com

# ═════════════════════════════════════════════════════════════
# SESSION & COOKIES
# ═════════════════════════════════════════════════════════════
SESSION_SECRET=another-secret-key-here
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# ═════════════════════════════════════════════════════════════
# LOGGING
# ═════════════════════════════════════════════════════════════
LOG_LEVEL=info
# Options: error, warn, info, debug, trace

# ═════════════════════════════════════════════════════════════
# FEATURES FLAGS
# ═════════════════════════════════════════════════════════════
ENABLE_TWILIO=false
ENABLE_JWT=false
ENABLE_ANALYTICS=false
ENABLE_NOTIFICATIONS=false

# ═════════════════════════════════════════════════════════════
# SECURITY
# ═════════════════════════════════════════════════════════════
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900  # 15 minutes in seconds

# ═════════════════════════════════════════════════════════════
# RATE LIMITING
# ═════════════════════════════════════════════════════════════
RATE_LIMIT_WINDOW=900000  # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100

# ═════════════════════════════════════════════════════════════
# EXTERNAL SERVICES (Optional)
# ═════════════════════════════════════════════════════════════
GOOGLE_MAPS_API_KEY=your-google-maps-key-here
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx

# ═════════════════════════════════════════════════════════════
# DEBUG
# ═════════════════════════════════════════════════════════════
DEBUG=false
VERBOSE_LOGS=false
