{
  "cli": {
    "appVersionSource": "appJson"
  },
  "expo": {
    "name": "WorldEvents",
    "slug": "stage",
    "version": "1.0.0",
    "owner": "ramez12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Utilisé pour prendre votre photo de profil avec détection du visage.",
        "NSPhotoLibraryUsageDescription": "Utilisé pour choisir votre photo de profil depuis la galerie.",
        "NSMicrophoneUsageDescription": "Accès au microphone pour la caméra.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ramez.worldevents"
    },
    "android": {
      "package": "com.ramez.worldevents",
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForTestingMapsWithoutCrash_WorldEvents"
        }
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050A18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser WorldEvents à accéder à la caméra pour la photo de profil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser WorldEvents à accéder à vos photos pour la photo de profil."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser WorldEvents à accéder à votre position pour choisir l'emplacement des événements sur la carte.",
          "locationWhenInUsePermission": "Autoriser WorldEvents à accéder à votre position pour afficher votre emplacement sur la carte."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "258ba7f1-3c5f-422c-8878-070f2b2db101"
      }
    }
  }
}
